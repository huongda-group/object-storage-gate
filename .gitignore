**/config/local.yaml
**/config/*.local.yaml
**/config/production.yaml

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# include cargo lock
!Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

*.sqlite
*.sqlite-*
console-object-storage-gate/

# S3 conformance suite — real credentials and its Python venv
tests/s3/.env
tests/s3/.venv/
tests/s3/__pycache__/
tests/s3/.pytest_cache/
.idea/
