# Copy to tests/s3/.env (gitignored) and fill in. Never commit real credentials.

# upstream = a real object store; gateway = Object Storage Gate itself
OSG_S3_TARGET=upstream

OSG_S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
OSG_S3_REGION=ap-southeast-1
OSG_S3_BUCKET=my-physical-bucket

# auto lets boto3 pick virtual-host style for AWS; the gateway will need path
OSG_S3_ADDRESSING=auto

# IAM user #1 — object access confined to osg-conformance/*, unconditional ListBucket
OSG_S3_KEY_FULL_ID=
OSG_S3_KEY_FULL_SECRET=

# IAM user #2 — everything confined to osg-conformance/allow/*
OSG_S3_KEY_SCOPED_ID=
OSG_S3_KEY_SCOPED_SECRET=
